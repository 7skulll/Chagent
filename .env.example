# Local PostgreSQL using the current OS user. Override host/user/password as needed.
CHAGENT_DATABASE_URL=postgresql:///chagent
# Required by Compose PostgreSQL and scripts/start-host-controller.command.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(36))'
# CHAGENT_DB_PASSWORD=replace-with-random-secret
CHAGENT_DB_POOL_MIN_SIZE=1
CHAGENT_DB_POOL_MAX_SIZE=4
CHAGENT_DB_TIMEOUT=5

# One programmable tool surface for every web session; there is no per-session
# mode to choose. CHAGENT_CODE_MODE=off disables unified web startup.
# CHAGENT_DEFAULT_MODE was removed together with the mode switch: setting it is
# refused at startup rather than silently ignored, so an old .env cannot look
# like it still selects something.
CHAGENT_CODE_MODE=on

# Native startup does not expose commands. Compose overrides the execution settings
# and asks by default: the mounted workspace is the user's own directory, so a
# command and an overwrite both land on their machine.
# Values: never, on-request, or untrusted (ask for every host command) inside the
# declared container. Any mode other than never also asks before a write replaces
# an existing file, before a patch, and before a new file lands in a hook or
# configuration path; creating a new file elsewhere stays silent.
CHAGENT_APPROVAL=never
# Colon-separated token prefixes that skip the *command* question, e.g. "pytest:git status".
# A command with shell operators (; | & < > ` $ ( )) is never allowlisted, and a
# write is never covered by this list.
# CHAGENT_APPROVAL_ALLOWLIST=pytest:git status
# How long a question stays open before it expires and the tool call is refused.
# CHAGENT_APPROVAL_TIMEOUT=300
# CHAGENT_RUN_WALL_TIMEOUT=3600  # 整轮墙钟上限，包含审批等待与工具执行
# A question needs someone to answer it: when no browser page has been subscribed
# to the run for this many seconds, the tool call is refused as "nobody watching"
# instead of waiting out the timeout. Reloading a page reconnects in a second or
# two, so the grace has to outlast that. 0 turns it off (absolute timeout only).
# CHAGENT_APPROVAL_UNWATCHED_GRACE=10

# Host-controller workspace containers stay warm for 30 minutes after use.
# 0 disables automatic idle reaping; active runs and sites are protected.
# CHAGENT_CONTAINER_IDLE_SECONDS=1800

# Long-running host commands. exec_command with yield_time_ms returns a
# process_id immediately and keeps the child alive across tool calls; the
# process() tool then reads or stops it. These bound that ability:
#   CHAGENT_MAX_PROCESSES  live processes one run may hold (1..16)
#   CHAGENT_PROCESS_TIMEOUT  wall clock for one process, in seconds
# Every process a run still owns is terminated when the run ends; a process
# never survives a restart, and its id is refused after one.
# CHAGENT_MAX_PROCESSES=4
# CHAGENT_PROCESS_TIMEOUT=600

# Configure ONE named provider key; its endpoint and model have presets.
# OPENAI_API_KEY=your-key
# DEEPSEEK_API_KEY=your-key
# ANTHROPIC_API_KEY=your-key
# DASHSCOPE_API_KEY=your-key

# If multiple provider keys exist, select one explicitly.
# CHAGENT_PROVIDER=deepseek
# CHAGENT_MODEL=deepseek-flash

# Custom OpenAI-compatible endpoint (all four fields required).
# CHAGENT_API_KEY is used only with custom; presets use their named keys.
# CHAGENT_PROVIDER=custom
# CHAGENT_API_KEY=your-key
# CHAGENT_BASE_URL=http://127.0.0.1:8080/v1
# CHAGENT_MODEL=local-model

# Optional application budgets and timeouts, not inferred model capabilities.
# CHAGENT_CONTEXT_WINDOW=65536
# CHAGENT_MAX_TOKENS=8192
# CHAGENT_MODEL_TIMEOUT=60
# CHAGENT_RUN_TIMEOUT=180
# A 429 or 5xx is repeated this many times (0.5s then 1.5s) before the turn
# fails; other 4xx answers are final because they will not change. Model
# requests have no side effects, so repeating one is safe. 0 = one attempt.
# CHAGENT_RETRY_ATTEMPTS=2

# Automatic compaction of completed historical turns (current run stays intact).
# CHAGENT_COMPACTION_ENABLED=true
# CHAGENT_COMPACTION_TRIGGER=0.8
# CHAGENT_COMPACTION_KEEP_RECENT=0.5
# CHAGENT_COMPACTION_SUMMARY_TOKENS=2048
# CHAGENT_COMPACTION_MAX_CALLS=8
# CHAGENT_COMPACTION_TIMEOUT=60
# CHAGENT_COMPACTION_MAX_PER_RUN=4
# Speculative compaction: start paying for the summary below the trigger, while
# the model is busy with tools, and install it only when the budget actually
# runs out. A candidate the run never needs costs its model calls and nothing
# else: nothing is written until it is adopted. Set to false to keep every
# summarization on the critical path.
# CHAGENT_COMPACTION_SPECULATIVE=true
# CHAGENT_COMPACTION_SPECULATIVE_TRIGGER=0.6
# How long run teardown waits for a cancelled speculative request to unwind.
# CHAGENT_COMPACTION_SPECULATIVE_TIMEOUT=5
# Second compaction implementation: instead of paying a model to compress the
# span, drop it and restate what it was (which turns went, the user requests as
# truncated quotes, the newest tool evidence). 'fallback' uses it only when the
# summarizer fails, which turns "budget exhausted and summarization failed" from
# a failed run into a continued one; 'always' skips the summarizer entirely;
# 'off' keeps summarization as the only implementation.
# CHAGENT_COMPACTION_FRESH_WINDOW=fallback
# Newest tool results carried verbatim inside a summary (0 summarizes all).
# CHAGENT_COMPACTION_RETAINED_TOOL_RESULTS=2
# Newest user requests carried verbatim inside a summary (0 disables the block).
# The host quotes them and strips them from what the model sees, so each
# generation copies the words instead of paraphrasing a paraphrase. Packed from
# the newest backwards; a request that no longer fits is dropped, never reworded.
# CHAGENT_COMPACTION_RETAINED_USER_REQUESTS=4
# Post-turn compaction: once the answer is committed, summarize the run that
# produced it while nothing is waiting, so the next request starts smaller
# instead of paying the summary on its critical path. Same gate as any other
# compaction, one pass per session at a time; a failed pass is audited and never
# marks the run failed. Off by default because it spends calls nobody asked for.
# CHAGENT_COMPACTION_POST_TURN=false
# Where the pass becomes worth paying for, as a fraction of the input budget;
# must not exceed CHAGENT_COMPACTION_TRIGGER.
# CHAGENT_COMPACTION_POST_TURN_TRIGGER=0.6

# Token counting is a heuristic with no extra dependency and no setting: ASCII
# costs 4 bytes per token, non-ASCII 1 token per character. After the first
# response of a run the provider's own usage count anchors the estimate, so only
# the appended messages are estimated. The name is recorded in the snapshot.
#
# Output reserved out of the context window. A chat-completions provider enforces
# input + output <= window, so this is also the requested max_tokens and cannot
# be lower than what an answer might need. Default: min(CHAGENT_MAX_TOKENS, 8192).
# Measured over 319 real calls: p50 98, p90 579, p99 3054, max 5140 output tokens,
# and no call ever hit a 16384 cap. Raising this costs input budget; lowering it
# fails a turn with output_limit rather than truncating silently.
# CHAGENT_OUTPUT_TOKENS=8192
# Model-visible cap for a single tool result, in tokens (default 2000).
# CHAGENT_TOOL_RESULT_TOKENS=2000

# Tool declarations. On, tools a session needs late or never (web, run_tests,
# process, create_file, host_exec) are listed by name only and their schemas are
# loaded with tool_search on demand: measured 3352 -> 2273 declaration tokens per
# request on a full face. Each load costs one extra model turn the first time the
# tool is actually needed, so turn it off for short task-shaped sessions.
# CHAGENT_DEFERRED_TOOLS=true
# CHAGENT_MAX_TURNS=32
# Shared tool execution limit per runner (1 disables parallel execution).
# CHAGENT_MAX_TOOL_CONCURRENCY=4

# Long-term memory: inferred records remain candidates until reviewed.
# CHAGENT_MEMORY_ENABLED=true
# CHAGENT_MEMORY_EXTRACT=true
# CHAGENT_MEMORY_TOKENS=2048
# CHAGENT_MEMORY_ITEMS=8
# CHAGENT_MEMORY_TIMEOUT=20
# Extraction is queued after the answer; this bounds retries per job.
# CHAGENT_MEMORY_ATTEMPTS=3
# Background workers for one process (1 disables parallel extraction).
# Must leave one connection for runs, so at most CHAGENT_DB_POOL_MAX_SIZE-1.
# CHAGENT_MEMORY_WORKER_CONCURRENCY=1

# Outbound HTTP: adds web_search and web_fetch, backed by DeepSeek's Search and
# Fetch API. These run inside the agent process, so the sandbox does not cover
# them: this switch is the only gate on leaving the machine, and "off" leaves
# the base tool surface unchanged.
#
# off | deepseek.  "tavily" was removed and is refused at startup rather than
# quietly mapped to another provider.
#
# The key: CHAGENT_SEARCH_API_KEY, falling back to DEEPSEEK_API_KEY when unset,
# so one key is enough to try it. Billed per request (5 CNY / 1000), not per
# result; only a request that returns results is charged. The request leaves
# from DeepSeek's network, not this machine.
# The endpoint is fixed to api.deepseek.com: CHAGENT_BASE_URL is not inherited,
# because it may point at a gateway that only serves chat completions.
# CHAGENT_WEB_ACCESS=off
# CHAGENT_SEARCH_API_KEY=

# Commands are available only with the containerized profile in compose.yaml.
CHAGENT_SANDBOX_WRITABLE=true

# The three execution axes are derived from these switches, never set directly:
#   boundary    container | none      where the process runs
#   capability  full | read-only      whether commands exist (CHAGENT_ALLOW_HOST_COMMANDS)
#   gate        none | approval       whether a human approves each command
# Only container + full may execute commands; the web page accepts gate=none or
# gate=approval. A combination that cannot exist is refused at startup.
#
# Native configuration does not expose command execution.
CHAGENT_EXECUTION_PROFILE=configured
CHAGENT_SANDBOX=off
CHAGENT_SANDBOX_NETWORK=false
CHAGENT_ALLOW_HOST_COMMANDS=false
# Container entry: compose.yaml overrides these values with
# CHAGENT_EXECUTION_PROFILE=containerized, CHAGENT_BOUNDARY=container,
# CHAGENT_CONTAINER_DECLARED=true, CHAGENT_SANDBOX=off and network=true.
# Set CHAGENT_WORKSPACES to an existing absolute host directory for Compose.
# Optional host execution agent (requires a separate interactive host terminal).
# CHAGENT_HOST_EXEC=approval
# CHAGENT_HOST_ENDPOINT=http://host.docker.internal:8766
# CHAGENT_HOST_TOKEN=<generate a random token of at least 32 characters>
