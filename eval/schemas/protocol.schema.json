{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chagent.local/eval/protocol.schema.json",
  "title": "Chagent evaluation pre-registration",
  "description": "What will be run, how many times, under which budget, and what result would count as an improvement — fixed before the first trial. Editing it after trials exist invalidates the experiment rather than redefining it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "experiment",
    "question",
    "hypothesis",
    "created_at",
    "cases",
    "arms",
    "repeats",
    "min_repeats_for_stability",
    "order",
    "budget",
    "thresholds",
    "analysis",
    "exclusions",
    "stopping_rule"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "experiment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "provider",
          "model"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,31}$"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      },
      "maxItems": 2
    },
    "repeats": {
      "type": "integer",
      "minimum": 2,
      "maximum": 25
    },
    "min_repeats_for_stability": {
      "type": "integer",
      "minimum": 3,
      "maximum": 25
    },
    "order": {
      "enum": [
        "interleaved",
        "blocked"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_turns",
        "wall_seconds",
        "max_tool_calls",
        "total_cost_usd"
      ],
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "total_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "improve_points",
        "regress_points"
      ],
      "description": "How large a difference must be before either direction is spoken of. Fractions of the per-case pass rate, fixed before running.",
      "properties": {
        "improve_points": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "regress_points": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "analysis": {
      "type": "string",
      "minLength": 1
    },
    "exclusions": {
      "type": "string",
      "minLength": 1
    },
    "stopping_rule": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Conservative per-million-token rate ceilings with an auditable source. Input rate must cover uncached, cached-read and cached-write input; output rate includes reasoning output. The harness reserves the configured maximum context/output cost before every real call. Missing pricing prevents paid execution; estimates are not provider invoices.",
      "required": [
        "input_usd_per_mtok",
        "output_usd_per_mtok",
        "source"
      ],
      "properties": {
        "input_usd_per_mtok": {
          "type": "number",
          "minimum": 0
        },
        "output_usd_per_mtok": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
