.venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/

# macOS
.DS_Store

# Vendored upstream reference sources (not this project's code)
/nanobot-main/
/pi-main1.4.0/

# Assistant workspace state (local notes and caches, not project content)
.workbuddy/

# Trial outputs are local artifacts. Keeping them out of `git ls-files` is also
# what keeps a version manifest stable: writing a result must not change the
# version of the tree that produced it.
/eval/results/

# Documents uploaded from the page land in <workspace>/uploads. When the
# workspace is this checkout, they are the user's files, never project content.
/uploads/
/.backups/

# Annotation ledger locks are local coordination state.
/eval/annotations/*.lock
